# Copia este archivo a .env.local y rellena con los valores del panel de Supabase
# (Configuración del proyecto → API).

# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable) — segura para el navegador, el RLS la limita
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio — SOLO servidor, salta el RLS. Nunca exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Clave propia (invéntala) para proteger /api/resultados
SINCRONIZACION_SECRETO=
